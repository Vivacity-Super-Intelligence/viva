{
  "version": 3,
  "configurePresets": [
    {"name": "native", "generator": "Ninja", "binaryDir": "${sourceDir}/build/native", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "sanitize", "inherits": "native", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": {"VIVA_SANITIZE": "ON"}}
  ],
  "buildPresets": [{"name": "native", "configurePreset": "native"}, {"name": "sanitize", "configurePreset": "sanitize"}],
  "testPresets": [{"name": "native", "configurePreset": "native", "output": {"outputOnFailure": true}}, {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}}]
}
